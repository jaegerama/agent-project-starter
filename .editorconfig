root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# Each language's own settings go in a section of their own, added during setup.

[*.md]
# Two trailing spaces are a deliberate line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

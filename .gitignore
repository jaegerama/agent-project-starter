# Secrets: never committed
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output: trim to this project's stack
node_modules/
vendor/
dist/
build/
.next/
__pycache__/
*.log

# Per-machine preferences; the rest of .claude/ is committed so the tooling travels.
.claude/settings.local.json

# Backups adopt writes before it replaces a file: copies of agent files that one
# `git add -A` would commit.
.claude.backup-*/

# OS
.DS_Store
Thumbs.db
